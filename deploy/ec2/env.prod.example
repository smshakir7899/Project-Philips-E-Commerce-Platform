# =============================================================================================
# deploy/ec2/env.prod.example - template for /opt/philips-ecommerce/.env on the EC2 instance.
#
# The real file is NEVER committed. Store it in Jenkins as a "Secret file" credential with ID
# `ec2-prod-env`; the Deploy to EC2 stage copies it to the instance (chmod 600).
# Better for real production: keep the values in AWS Secrets Manager / SSM Parameter Store and
# render this file at deploy time.
# Replace every CHANGE_ME value.
# =============================================================================================

# --- Images -----------------------------------------------------------------------------------
# ECR registry URI (account + region), WITHOUT the repository path.
DOCKER_REGISTRY=CHANGE_ME.dkr.ecr.eu-west-1.amazonaws.com
# Overwritten by deploy.sh <tag> (Jenkins passes the build's IMAGE_TAG, e.g. git short SHA).
IMAGE_TAG=CHANGE_ME

# --- MySQL (container on the host; recommended: Amazon RDS) -----------------------------------
# Long random values, e.g. `openssl rand -base64 24`. Changing them after the first start has no
# effect on an existing mysql-data volume (init scripts only run on an empty data dir).
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_USER=philips
MYSQL_PASSWORD=CHANGE_ME

# --- AWS / S3 ---------------------------------------------------------------------------------
# NO AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: the instance profile (IAM role) supplies credentials.
AWS_REGION=eu-west-1
S3_BUCKET=philips-product-images
# The bucket is PRIVATE (Block Public Access on). Direct S3 URLs therefore return 403 for anonymous
# clients: serve images through CloudFront with Origin Access Control (put the distribution URL here),
# or have clients use the presigned-URL endpoint (GET /api/products/{id}/images/{imageId}/presigned-url).
S3_PUBLIC_BASE_URL=https://philips-product-images.s3.eu-west-1.amazonaws.com
# S3_PUBLIC_BASE_URL=https://CHANGE_ME.cloudfront.net

# --- product-service behaviour ----------------------------------------------------------------
PRODUCT_QUERY_MODE=optimized
PRODUCT_CACHE_ENABLED=true
