{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProductImageObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::philips-product-images/products/*"
    },
    {
      "Sid": "ListOnlyProductPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::philips-product-images",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "products/",
            "products/*"
          ]
        }
      }
    }
  ]
}
