# =============================================================================================
# Copy to .env (git-ignored) and adjust:   cp .env.example .env
# docker compose reads .env automatically for ${VAR} substitution in docker-compose.yml.
#
# These are SAFE LOCAL DEFAULTS for a laptop - they are not secrets and must NEVER be reused on
# a reachable machine. Every line marked [EC2] must be changed for a deployment
# (see deploy/ec2/env.prod.example; on EC2 the .env comes from a Jenkins secret-file credential).
# =============================================================================================

# ---- MySQL (one container, one schema per service) -------------------------------------------
MYSQL_ROOT_PASSWORD=root_pwd          # [EC2] long random value (or use RDS + Secrets Manager)
MYSQL_USER=philips                    # app user, gets rights on philips_* schemas (docker/mysql/init)
MYSQL_PASSWORD=philips_pwd            # [EC2] long random value

# ---- MinIO = local S3 replacement -------------------------------------------------------------
MINIO_ROOT_USER=minioadmin            # local only; there is NO MinIO on EC2 (real S3 is used)
MINIO_ROOT_PASSWORD=minioadmin        # local only

# ---- AWS / S3 (product images) -----------------------------------------------------------------
AWS_REGION=eu-west-1                  # [EC2] region of the real bucket
S3_BUCKET=philips-product-images      # [EC2] bucket names are global - yours may need a suffix
# Locally product-service talks to MinIO with the MinIO root credentials (set in docker-compose.yml).
# [EC2] NO access keys at all: the EC2 instance profile (IAM role) provides temporary credentials.

# ---- Images ------------------------------------------------------------------------------------
IMAGE_TAG=local                       # [EC2] immutable tag pushed by Jenkins, e.g. 42-a1b2c3d
# DOCKER_REGISTRY=123456789012.dkr.ecr.eu-west-1.amazonaws.com   # [EC2] only used by deploy/

# ---- product-service performance experiment (perf/) -------------------------------------------
PRODUCT_QUERY_MODE=optimized          # optimized | baseline (N+1 queries on purpose)
PRODUCT_CACHE_ENABLED=true            # true | false (Redis cache-aside on product detail)
